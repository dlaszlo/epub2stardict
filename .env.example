# OpenAI-compatible LLM endpoint. OpenRouter, OpenAI, or a local Ollama
# (in OpenAI-compat mode) — all three work with the same three variables.
#
# Examples:
#   OpenRouter (Gemini Flash, cheap+good):
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=google/gemini-3-flash-preview
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini
#   Ollama (local):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1:8b
#     LLM_API_KEY=ollama   # SDK requires a non-empty value

LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5

# Test runs: only the first N unique words go through the whole pipeline.
# Picked up by the 400 step, so all downstream scripts (500/550/600)
# inherit the limit automatically. Empty / 0 / unset = no limit.
# LIMIT_WORDS=50

# Concurrency for the 500 step. The LLM is the slow part: requests are
# batched (BATCH_SIZE words per request) and run in parallel (NUM_WORKERS
# threads). Tune them to your provider's rate limits.
#   - OpenRouter / OpenAI: 8 workers x 5 words is a safe starting point.
#   - Ollama (local): set NUM_WORKERS=1 (a local model usually can't
#     serve parallel requests anyway).
# LLM_BATCH_SIZE=5
# LLM_NUM_WORKERS=8

# The `response_format={"type": "json_object"}` parameter forces the model
# to return valid JSON. Strong models (Claude, GPT-4 family, Gemini) support
# it and produce more stable output. Many Llama deployments on OpenRouter
# do NOT support it and silently return empty output ("empty response from
# model" error).
#   1/true/yes/on (default) — send the parameter
#   0/false/no/off          — don't send (Llama, smaller open models)
# LLM_JSON_RESPONSE_FORMAT=1
